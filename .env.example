# Sentry Error Tracking (optional - leave empty to disable)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_DEBUG=false

# Optional GitHub owner/repo used by Spire app update checks.
# Defaults to fryguy503/spire when unset.
SPIRE_RELEASE_REPO=

# Automatic update restart: self for direct launches and Linux service managers.
# Windows service wrappers must use managed and restart Spire on exit code 75.
# SPIRE_RESTART_MODE=managed
